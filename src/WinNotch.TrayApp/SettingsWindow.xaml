<Window x:Class="WinNotch.TrayApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch Ayarları"
        Width="400" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        Foreground="#FFFFFFFF">

    <!--
        Settings Window
        Dark theme to match the notch aesthetic.
        Provides module toggles, monitor selection, and diagnostics.
    -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="✦ WinNotch Ayarları"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#FFFFFFFF"/>
            <TextBlock Text="Modülleri aç/kapat, monitör seç, ayarları yapılandır"
                       FontSize="11"
                       Foreground="#99FFFFFF"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Module Toggles -->
                <TextBlock Text="📦 MODÜLLER"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF0078D4"
                           Margin="0,0,0,8"/>

                <CheckBox x:Name="ModuleACheckBox"
                          Content="Module A — Sürükle &amp; Bırak Yolu Çıkarma"
                          Foreground="#CCFFFFFF"
                          Margin="0,0,0,8"
                          Checked="ModuleCheckBox_Changed"
                          Unchecked="ModuleCheckBox_Changed"/>

                <CheckBox x:Name="ModuleBCheckBox"
                          Content="Module B — Clipboard Dinleyici"
                          Foreground="#CCFFFFFF"
                          Margin="0,0,0,8"
                          Checked="ModuleCheckBox_Changed"
                          Unchecked="ModuleCheckBox_Changed"/>

                <CheckBox x:Name="ModuleCCheckBox"
                          Content="Module C — Medya Oynatıcı (SMTC)"
                          Foreground="#CCFFFFFF"
                          Margin="0,0,0,8"
                          Checked="ModuleCheckBox_Changed"
                          Unchecked="ModuleCheckBox_Changed"/>

                <CheckBox x:Name="ModuleDCheckBox"
                          Content="Module D — Pencere Sabitleyici"
                          Foreground="#CCFFFFFF"
                          Margin="0,0,0,8"
                          Checked="ModuleCheckBox_Changed"
                          Unchecked="ModuleCheckBox_Changed"/>

                <CheckBox x:Name="ModuleECheckBox"
                          Content="Module E — Ekran Görüntüsü Köprüsü"
                          Foreground="#CCFFFFFF"
                          Margin="0,0,0,16"/>

                <!-- Monitor Selection -->
                <TextBlock Text="🖥️ MONİTÖR"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF0078D4"
                           Margin="0,0,0,8"/>

                <ComboBox x:Name="MonitorComboBox"
                          Background="#FF2D2D2D"
                          Foreground="#CCFFFFFF"
                          Margin="0,0,0,16"
                          SelectionChanged="MonitorComboBox_SelectionChanged"/>

                <!-- Startup -->
                <TextBlock Text="🚀 BAŞLANGIÇ"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF0078D4"
                           Margin="0,0,0,8"/>

                <CheckBox x:Name="AutoStartCheckBox"
                          Content="Windows ile otomatik başlat"
                          Foreground="#CCFFFFFF"
                          Margin="0,0,0,16"
                          Checked="AutoStartCheckBox_Changed"
                          Unchecked="AutoStartCheckBox_Changed"/>

                <!-- Diagnostics -->
                <TextBlock Text="📊 TEŞHİS"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF0078D4"
                           Margin="0,0,0,8"/>

                <CheckBox x:Name="DiagnosticsCheckBox"
                          Content="Teşhis panelini göster (Debug modu)"
                          Foreground="#CCFFFFFF"
                          Margin="0,0,0,8"
                          Checked="DiagnosticsCheckBox_Changed"
                          Unchecked="DiagnosticsCheckBox_Changed"/>

                <!-- Performance Stats -->
                <Border Background="#FF2D2D2D"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Performans Durumu"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="RamUsageText"
                                   Text="RAM: Hesaplanıyor..."
                                   Foreground="#99FFFFFF"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="CpuUsageText"
                                   Text="CPU: Hesaplanıyor..."
                                   Foreground="#99FFFFFF"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Kapat"
                    Padding="20,8"
                    Background="#FF0078D4"
                    Foreground="#FFFFFFFF"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
