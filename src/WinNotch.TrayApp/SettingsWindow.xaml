<Window x:Class="WinNotch.TrayApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch Ayarları"
        Width="560" Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF101012"
        Foreground="#FFF5F5F7"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FF18181B"/>
            <Setter Property="BorderBrush" Value="#FF29292E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFF2F2F4"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#FF8D8D96"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE2E2E6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="18" Height="18"
                                    CornerRadius="5"
                                    Background="#FF222227"
                                    BorderBrush="#FF3A3A42"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Tick"
                                           Text="✓"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF2D7DFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF2D7DFF"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF6A6A75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#FF222226"/>
            <Setter Property="Foreground" Value="#FFF2F2F4"/>
            <Setter Property="BorderBrush" Value="#FF34343B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#FF2D7DFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#FF438CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#FF216FE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF2A2A30" BorderThickness="1" Background="#FF101012">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- Custom dark title area -->
            <Grid Grid.Row="0"
                  Background="#FF141416"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="20,12,0,0">
                    <TextBlock Text="WinNotch"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#FFF7F7F8"/>
                    <TextBlock Text="Ayarlar"
                               FontSize="10"
                               Foreground="#FF777780"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="×"
                        FontSize="20"
                        Foreground="#FFB8B8BF"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
                <Border Grid.RowSpan="1"
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="#FF242429"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="18,18,8,0"
                          Padding="0,0,10,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Özellikler"/>
                            <TextBlock Style="{StaticResource SectionDescription}"
                                       Text="Yalnız kullandığın özellikleri açık tut. Medya entegrasyonu ek bellek kullanır."/>

                            <CheckBox x:Name="ModuleACheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Dosya Rafı — dosyaları tut, kopyala ve yeniden sürükle"
                                      Checked="ModuleCheckBox_Changed"
                                      Unchecked="ModuleCheckBox_Changed"/>
                            <CheckBox x:Name="ModuleBCheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Akıllı Pano — URL, yol ve anlamlı içerikleri yakala"
                                      Checked="ModuleCheckBox_Changed"
                                      Unchecked="ModuleCheckBox_Changed"/>
                            <CheckBox x:Name="ModuleCCheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Medya Kontrolleri — sistem medya oturumunu göster"
                                      Checked="ModuleCheckBox_Changed"
                                      Unchecked="ModuleCheckBox_Changed"/>
                            <CheckBox x:Name="ModuleDCheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Pencere Sabitleme — aktif pencereyi üstte tut"
                                      Checked="ModuleCheckBox_Changed"
                                      Unchecked="ModuleCheckBox_Changed"/>
                            <CheckBox x:Name="ModuleECheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Ekran Görüntüleri — Snipping Tool sonucunu yüzeyde göster"
                                      Margin="0"
                                      Checked="ModuleCheckBox_Changed"
                                      Unchecked="ModuleCheckBox_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Davranış"/>
                            <TextBlock Style="{StaticResource SectionDescription}"
                                       Text="Yüzeyin ne zaman görüneceğini ve ne kadar tepki vereceğini belirle."/>

                            <TextBlock Text="Görünürlük"
                                       Foreground="#FFBDBDC5"
                                       FontSize="10.5"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="VisibilityModeComboBox"
                                      Style="{StaticResource ModernCombo}"
                                      Margin="0,0,0,12"
                                      SelectionChanged="VisibilityModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Otomatik — tam ekranda gizle" Tag="Auto"/>
                                <ComboBoxItem Content="Her zaman göster" Tag="AlwaysShow"/>
                                <ComboBoxItem Content="Gizli" Tag="Hidden"/>
                            </ComboBox>

                            <TextBlock Text="Tepki seviyesi"
                                       Foreground="#FFBDBDC5"
                                       FontSize="10.5"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="ReactionLevelComboBox"
                                      Style="{StaticResource ModernCombo}"
                                      SelectionChanged="ReactionLevelComboBox_SelectionChanged">
                                <ComboBoxItem Content="Sessiz — yalnız doğrudan aksiyonlar" Tag="Quiet"/>
                                <ComboBoxItem Content="Dengeli — önerilen" Tag="Balanced"/>
                                <ComboBoxItem Content="Aktif — daha fazla bağlamsal bildirim" Tag="Active"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Ekran ve başlangıç"/>
                            <TextBlock Style="{StaticResource SectionDescription}"
                                       Text="WinNotch'un hangi monitöre bağlanacağını ve Windows ile başlayıp başlamayacağını seç."/>

                            <ComboBox x:Name="MonitorComboBox"
                                      Style="{StaticResource ModernCombo}"
                                      Margin="0,0,0,12"
                                      SelectionChanged="MonitorComboBox_SelectionChanged"/>
                            <CheckBox x:Name="AutoStartCheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Windows ile otomatik başlat"
                                      Margin="0"
                                      Checked="AutoStartCheckBox_Changed"
                                      Unchecked="AutoStartCheckBox_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Teşhis"/>
                            <TextBlock Style="{StaticResource SectionDescription}"
                                       Text="Geliştirme sırasında anlık process kullanımını göster. Kapalıyken sayaç çalışmaz."/>
                            <CheckBox x:Name="DiagnosticsCheckBox"
                                      Style="{StaticResource ModernCheckBox}"
                                      Content="Performans panelini göster"
                                      Checked="DiagnosticsCheckBox_Changed"
                                      Unchecked="DiagnosticsCheckBox_Changed"/>

                            <Border x:Name="PerformancePanel"
                                    Visibility="Collapsed"
                                    Background="#FF202024"
                                    BorderBrush="#FF303036"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12"
                                    Margin="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Bellek"
                                                   FontSize="9.5"
                                                   Foreground="#FF777780"/>
                                        <TextBlock x:Name="RamUsageText"
                                                   Text="—"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFEDEDF0"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CPU"
                                                   FontSize="9.5"
                                                   Foreground="#FF777780"/>
                                        <TextBlock x:Name="CpuUsageText"
                                                   Text="—"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFEDEDF0"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Background="#FF141416">
                <Border VerticalAlignment="Top" Height="1" Background="#FF242429"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,18,0">
                    <Button Content="Bitti"
                            Style="{StaticResource PrimaryButton}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
