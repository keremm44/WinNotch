<Window x:Class="WinNotch.TrayApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinNotch.TrayApp"
        Title="WinNotch Ayarları"
        Width="560" Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Base}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          Color="#FF000000"
                          BlurRadius="16"
                          ShadowDepth="3"
                          Direction="270"
                          Opacity="0.18"
                          RenderingBias="Quality"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Premium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}"/>
            <Setter Property="Padding" Value="{DynamicResource Thickness.CardPadding}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SettingsToggleRow" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="-8,0,-8,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RowSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0"/>
                                <Border x:Name="ToggleTrack"
                                        Grid.Column="1"
                                        Width="36" Height="20"
                                        CornerRadius="10"
                                        Background="{DynamicResource Brush.Surface.Control}"
                                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Border x:Name="ToggleKnob"
                                            Width="14" Height="14"
                                            CornerRadius="7"
                                            Background="{DynamicResource Brush.Text.Muted}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="2,0,0,0"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource Brush.Surface.Softer}"/>
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource Brush.Text.Faint}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource Brush.Accent.Primary}"/>
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/>
                                <Setter TargetName="ToggleKnob" Property="Background" Value="{DynamicResource Brush.Accent.Foreground}"/>
                                <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="ToggleKnob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentSurface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentSurface" Property="Background" Value="{DynamicResource Brush.Accent.Selection}"/>
                                <Setter TargetName="SegmentSurface" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Accent.Selection}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Margin="12,0,38,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="{DynamicResource Brush.Text.Muted}"
                                          StrokeThickness="1.4"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,13,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=ComboSurface}"
                                        MinWidth="220"
                                        MaxHeight="240"
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Background="{DynamicResource Brush.Surface.Popup}"
                                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource Brush.Text.Faint}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="36" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface"
                                                        Background="{DynamicResource Brush.Border.Strong}"
                                                        CornerRadius="4"
                                                        Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource Brush.Text.Muted}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Foreground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border Height="1"
                                        Margin="2,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.Surface.Highlight}"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource Brush.Accent.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource Brush.Accent.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            Background="{DynamicResource Brush.Window.Base}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{DynamicResource Brush.Window.Header}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="32" Height="32"
                            CornerRadius="10"
                            Background="{DynamicResource Brush.Accent.Selection}"
                            BorderBrush="{DynamicResource Brush.Accent.Border}"
                            BorderThickness="1"
                            Margin="0,0,11,0">
                        <Grid>
                            <Ellipse Width="14" Height="14"
                                     Fill="{DynamicResource Brush.Accent.Glow}"/>
                            <Border Width="13" Height="3"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource Brush.Accent.Primary}"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WinNotch"
                                   FontSize="16.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <TextBlock Text="AYARLAR  ·  KİŞİSELLEŞTİRME"
                                   FontSize="7.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Faint}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="×"
                        FontSize="20"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
                <Border VerticalAlignment="Bottom" Height="1"
                        Background="{DynamicResource Brush.Border.Subtle}"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="18,18,10,0"
                          Padding="0,0,8,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Özellikler"/>
                            <TextBlock Style="{StaticResource SectionDescription}"
                                       Text="Yalnız kullandığın yüzeyleri açık tut. Medya entegrasyonu ek bellek kullanır."/>

                            <CheckBox x:Name="ModuleACheckBox" Style="{StaticResource SettingsToggleRow}"
                                      Checked="ModuleCheckBox_Changed" Unchecked="ModuleCheckBox_Changed">
                                <StackPanel>
                                    <TextBlock Text="Dosya Rafı" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Dosyaları geçici olarak tut, kopyala ve yeniden sürükle"
                                               FontSize="9.5" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ModuleBCheckBox" Style="{StaticResource SettingsToggleRow}"
                                      Checked="ModuleCheckBox_Changed" Unchecked="ModuleCheckBox_Changed">
                                <StackPanel>
                                    <TextBlock Text="Akıllı Pano" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="URL, dosya yolu ve anlamlı içeriklerde bağlamsal aksiyon göster"
                                               FontSize="9.5" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ModuleCCheckBox" Style="{StaticResource SettingsToggleRow}"
                                      Checked="ModuleCheckBox_Changed" Unchecked="ModuleCheckBox_Changed">
                                <StackPanel>
                                    <TextBlock Text="Medya Kontrolleri" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Aktif sistem medya oturumunu kompakt yüzeyde göster"
                                               FontSize="9.5" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ModuleECheckBox" Style="{StaticResource SettingsToggleRow}"
                                      Checked="ModuleCheckBox_Changed" Unchecked="ModuleCheckBox_Changed">
                                <StackPanel>
                                    <TextBlock Text="Ekran Görüntüleri" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Snipping Tool sonucunu önizle ve hızlıca kaydet"
                                               FontSize="9.5" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Davranış"/>
                            <TextBlock Style="{StaticResource SectionDescription}"
                                       Text="Yüzeyin ne zaman görüneceğini ve ne kadar tepki vereceğini belirle."/>

                            <TextBlock Text="Görünürlük" Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="10.5" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource Brush.Surface.Control}"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                    BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="VisibilityAutoRadio" Grid.Column="0" GroupName="VisibilityMode"
                                                 Style="{StaticResource SegmentRadio}" Content="Otomatik" Tag="Auto"
                                                 Checked="VisibilityModeRadio_Checked"/>
                                    <RadioButton x:Name="VisibilityAlwaysRadio" Grid.Column="1" GroupName="VisibilityMode"
                                                 Style="{StaticResource SegmentRadio}" Content="Her zaman" Tag="AlwaysShow"
                                                 Checked="VisibilityModeRadio_Checked"/>
                                    <RadioButton x:Name="VisibilityHiddenRadio" Grid.Column="2" GroupName="VisibilityMode"
                                                 Style="{StaticResource SegmentRadio}" Content="Gizli" Tag="Hidden"
                                                 Checked="VisibilityModeRadio_Checked"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Tepki seviyesi" Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="10.5" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource Brush.Surface.Control}"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                    BorderThickness="1" CornerRadius="8" Padding="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ReactionQuietRadio" Grid.Column="0" GroupName="ReactionLevel"
                                                 Style="{StaticResource SegmentRadio}" Content="Sessiz" Tag="Quiet"
                                                 Checked="ReactionLevelRadio_Checked"/>
                                    <RadioButton x:Name="ReactionBalancedRadio" Grid.Column="1" GroupName="ReactionLevel"
                                                 Style="{StaticResource SegmentRadio}" Content="Dengeli" Tag="Balanced"
                                                 Checked="ReactionLevelRadio_Checked"/>
                                    <RadioButton x:Name="ReactionActiveRadio" Grid.Column="2" GroupName="ReactionLevel"
                                                 Style="{StaticResource SegmentRadio}" Content="Aktif" Tag="Active"
                                                 Checked="ReactionLevelRadio_Checked"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <local:AppearanceSettingsCard x:Name="AppearanceCard"
                                                  AppearanceChanged="AppearanceCard_AppearanceChanged"/>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Ekran ve başlangıç"/>
                            <TextBlock Style="{StaticResource SectionDescription}"
                                       Text="WinNotch'un hangi monitöre bağlanacağını ve Windows ile başlayıp başlamayacağını seç."/>
                            <TextBlock Text="Hedef monitör" Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="10.5" Margin="0,0,0,6"/>
                            <ComboBox x:Name="MonitorComboBox"
                                      Style="{StaticResource ModernCombo}"
                                      Margin="0,0,0,8"
                                      SelectionChanged="MonitorComboBox_SelectionChanged"/>
                            <CheckBox x:Name="AutoStartCheckBox"
                                      Style="{StaticResource SettingsToggleRow}"
                                      Checked="AutoStartCheckBox_Changed"
                                      Unchecked="AutoStartCheckBox_Changed">
                                <StackPanel>
                                    <TextBlock Text="Windows ile otomatik başlat" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Oturum açıldığında WinNotch'u sessizce başlat"
                                               FontSize="9.5" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Teşhis"/>
                            <TextBlock Style="{StaticResource SectionDescription}"
                                       Text="Geliştirme sırasında anlık process kullanımını göster. Kapalıyken sayaç çalışmaz."/>
                            <CheckBox x:Name="DiagnosticsCheckBox"
                                      Style="{StaticResource SettingsToggleRow}"
                                      Checked="DiagnosticsCheckBox_Changed"
                                      Unchecked="DiagnosticsCheckBox_Changed">
                                <StackPanel>
                                    <TextBlock Text="Performans panelini göster" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Bellek ve CPU örneklerini yalnız bu pencere açıkken izle"
                                               FontSize="9.5" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>

                            <Border x:Name="PerformancePanel"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource Brush.Surface.Control}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12"
                                    Margin="0,5,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Bellek" FontSize="9.5" Foreground="{DynamicResource Brush.Text.Faint}"/>
                                        <TextBlock x:Name="RamUsageText" Text="—" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CPU" FontSize="9.5" Foreground="{DynamicResource Brush.Text.Faint}"/>
                                        <TextBlock x:Name="CpuUsageText" Text="—" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Background="{DynamicResource Brush.Window.Header}">
                <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource Brush.Border.Subtle}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,18,0">
                    <Button Content="Bitti"
                            Style="{StaticResource PrimaryButton}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>