<UserControl x:Class="WinNotch.TrayApp.AppearancePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="PreviewModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Accent.Selection}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface.Control}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10"
            Margin="0,0,0,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="96"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ClipToBounds="True">
                <Border Height="1"
                        VerticalAlignment="Top"
                        Background="{DynamicResource Brush.Border.Subtle}"/>

                <Border x:Name="PreviewNotch"
                        Width="294" Height="64"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Notch.Base}"
                        BorderBrush="{DynamicResource Brush.Border.LightTheme}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,11,11"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Idle -->
                        <Grid x:Name="IdlePreview" Visibility="Collapsed"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="PreviewIdleGlow"
                                    Width="38" Height="13"
                                    CornerRadius="7"
                                    Background="{DynamicResource Brush.Notch.AmbientGlow}"
                                    Opacity="0.58"
                                    Visibility="Collapsed"/>
                            <Border x:Name="PreviewIdleLine"
                                    Width="20" Height="3"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource Brush.Notch.Handle}"/>
                            <StackPanel x:Name="PreviewIdleDots"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource Brush.Notch.Handle}" Margin="0,0,3,0"/>
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource Brush.Notch.Handle}" Margin="0,0,3,0"/>
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource Brush.Notch.Handle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Context action -->
                        <Grid x:Name="ActionPreview" Margin="10,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="26" Height="26"
                                    CornerRadius="7"
                                    Background="{DynamicResource Brush.State.Clipboard.Subtle}"
                                    BorderBrush="{DynamicResource Brush.State.Clipboard.Border}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path Data="{DynamicResource Icon.Link}"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.State.Clipboard}"
                                      StrokeThickness="1.45"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="github.com/••••"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                                <TextBlock Text="Bağlantı panoya alındı"
                                           FontSize="8.5"
                                           Foreground="{DynamicResource Brush.Text.OnDarkSecondary}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Height="28"
                                    MinWidth="54"
                                    Padding="12,0"
                                    CornerRadius="7"
                                    Background="{DynamicResource Brush.Accent.Primary}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Aç"
                                           Foreground="{DynamicResource Brush.Accent.Foreground}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Media -->
                        <Grid x:Name="MediaPreview" Margin="10,7" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40"
                                    CornerRadius="8"
                                    Background="{DynamicResource Brush.State.Media.Subtle}"
                                    BorderBrush="{DynamicResource Brush.State.Media.Border}"
                                    BorderThickness="1">
                                <Path Data="{DynamicResource Icon.Media}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.State.Media}"
                                      StrokeThickness="1.4"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Grid Grid.Column="1" Margin="9,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="WinNotch Preview"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                                <TextBlock Grid.Row="1" Text="Artist · Spotify"
                                           FontSize="8.5"
                                           Foreground="{DynamicResource Brush.Text.OnDarkSecondary}"
                                           Margin="0,1,0,0"/>
                                <Border Grid.Row="2" Height="3" CornerRadius="1.5"
                                        Background="{DynamicResource Brush.Surface.Soft}"
                                        Margin="0,5,0,0">
                                    <Border Width="70" HorizontalAlignment="Left"
                                            CornerRadius="1.5"
                                            Background="{DynamicResource Brush.State.Media}"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="▶"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="14"
                                       Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Surface.Softer}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="2">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PreviewIdleRadio"
                                 GroupName="PreviewMode"
                                 Tag="Idle"
                                 Content="Boşta"
                                 Style="{StaticResource PreviewModeRadio}"
                                 Checked="PreviewMode_Checked"/>
                    <RadioButton x:Name="PreviewActionRadio"
                                 GroupName="PreviewMode"
                                 Tag="Action"
                                 Content="Aksiyon"
                                 IsChecked="True"
                                 Style="{StaticResource PreviewModeRadio}"
                                 Checked="PreviewMode_Checked"/>
                    <RadioButton x:Name="PreviewMediaRadio"
                                 GroupName="PreviewMode"
                                 Tag="Media"
                                 Content="Medya"
                                 Style="{StaticResource PreviewModeRadio}"
                                 Checked="PreviewMode_Checked"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
