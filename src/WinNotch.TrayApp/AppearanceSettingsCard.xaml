<UserControl x:Class="WinNotch.TrayApp.AppearanceSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="ChoiceRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="7,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Accent.Selection}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring"
                                Width="30" Height="30"
                                CornerRadius="15"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Border.Strong}"
                                BorderThickness="1">
                            <Ellipse x:Name="Swatch"
                                     Width="20" Height="20"
                                     Fill="{TemplateBinding Background}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Text.Muted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/>
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface.Raised}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Large}"
            Padding="{DynamicResource Thickness.CardPadding}"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="Görünüm"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}"/>
            <TextBlock Text="WinNotch'un karakterini değiştir; temel geometri ve okunabilirlik sınırları korunur."
                       FontSize="10.5"
                       Foreground="{DynamicResource Brush.Text.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,3,0,12"/>

            <local:AppearancePreviewView xmlns:local="clr-namespace:WinNotch.TrayApp"
                                         x:Name="AppearancePreview"/>

            <TextBlock Text="Tema"
                       FontSize="10"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,0,5"/>
            <Border Background="{DynamicResource Brush.Surface.Control}"
                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="2"
                    Margin="0,0,0,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="ThemeObsidianRadio" Grid.Column="0"
                                 GroupName="ThemePreset" Tag="Obsidian" Content="Obsidian"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="ThemeAuroraRadio" Grid.Column="1"
                                 GroupName="ThemePreset" Tag="Aurora" Content="Aurora"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="ThemeMonochromeRadio" Grid.Column="2"
                                 GroupName="ThemePreset" Tag="Monochrome" Content="Mono"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="ThemePaperRadio" Grid.Column="3"
                                 GroupName="ThemePreset" Tag="Paper" Content="Paper"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                </Grid>
            </Border>

            <TextBlock Text="Vurgu rengi"
                       FontSize="10"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                <RadioButton x:Name="AccentBlueRadio" GroupName="AccentPreset" Tag="Blue"
                             Style="{StaticResource AccentRadio}" Background="#FF2D7DFF"
                             ToolTip="Mavi" Checked="AppearanceRadio_Checked"/>
                <RadioButton x:Name="AccentVioletRadio" GroupName="AccentPreset" Tag="Violet"
                             Style="{StaticResource AccentRadio}" Background="#FF8C6CFF"
                             ToolTip="Mor" Checked="AppearanceRadio_Checked"/>
                <RadioButton x:Name="AccentCyanRadio" GroupName="AccentPreset" Tag="Cyan"
                             Style="{StaticResource AccentRadio}" Background="#FF23B7C9"
                             ToolTip="Cyan" Checked="AppearanceRadio_Checked"/>
                <RadioButton x:Name="AccentAmberRadio" GroupName="AccentPreset" Tag="Amber"
                             Style="{StaticResource AccentRadio}" Background="#FFF0A43C"
                             ToolTip="Amber" Checked="AppearanceRadio_Checked"/>
                <RadioButton x:Name="AccentGreenRadio" GroupName="AccentPreset" Tag="Green"
                             Style="{StaticResource AccentRadio}" Background="#FF35B982"
                             ToolTip="Yeşil" Checked="AppearanceRadio_Checked"/>
                <RadioButton x:Name="AccentSystemRadio" GroupName="AccentPreset" Tag="System"
                             Style="{StaticResource AccentRadio}" Background="{DynamicResource Brush.Accent.Primary}"
                             ToolTip="Windows sistem rengi" Checked="AppearanceRadio_Checked"/>
                <TextBlock Text="Sistem"
                           VerticalAlignment="Center"
                           FontSize="9"
                           Foreground="{DynamicResource Brush.Text.Muted}"/>
            </StackPanel>

            <Grid Margin="0,0,0,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Yoğunluk" FontSize="10"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource Brush.Surface.Control}"
                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                            BorderThickness="1" CornerRadius="8" Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="DensityCompactRadio" Grid.Column="0"
                                         GroupName="DensityMode" Tag="Compact" Content="Kompakt"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                            <RadioButton x:Name="DensityComfortableRadio" Grid.Column="1"
                                         GroupName="DensityMode" Tag="Comfortable" Content="Rahat"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hareket" FontSize="10"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource Brush.Surface.Control}"
                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                            BorderThickness="1" CornerRadius="8" Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="MotionReducedRadio" Grid.Column="0"
                                         GroupName="MotionMode" Tag="Reduced" Content="Azaltılmış"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                            <RadioButton x:Name="MotionNormalRadio" Grid.Column="1"
                                         GroupName="MotionMode" Tag="Normal" Content="Normal"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="Boşta görünümü"
                       FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,5"/>
            <Border Background="{DynamicResource Brush.Surface.Control}"
                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                    BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,11">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <RadioButton x:Name="IdleLineRadio" Grid.Column="0"
                                 GroupName="IdleStyle" Tag="Line" Content="Çizgi"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="IdleDotRadio" Grid.Column="1"
                                 GroupName="IdleStyle" Tag="Dot" Content="Nokta"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="IdleAmbientRadio" Grid.Column="2"
                                 GroupName="IdleStyle" Tag="Ambient" Content="Ambient"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Durum renkleri" FontSize="10"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource Brush.Surface.Control}"
                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                            BorderThickness="1" CornerRadius="8" Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="StateUnifiedRadio" Grid.Column="0"
                                         GroupName="StateAccentMode" Tag="Unified" Content="Tek renk"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                            <RadioButton x:Name="StateSemanticRadio" Grid.Column="1"
                                         GroupName="StateAccentMode" Tag="Semantic" Content="Bağlamsal"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="İçerik gizliliği" FontSize="10"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource Brush.Surface.Control}"
                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                            BorderThickness="1" CornerRadius="8" Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="PrivacyFullRadio" Grid.Column="0"
                                         GroupName="PrivacyPreviewMode" Tag="Full" Content="Tam"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                            <RadioButton x:Name="PrivacyMaskedRadio" Grid.Column="1"
                                         GroupName="PrivacyPreviewMode" Tag="Masked" Content="Maskeli"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                            <RadioButton x:Name="PrivacyTypeOnlyRadio" Grid.Column="2"
                                         GroupName="PrivacyPreviewMode" Tag="TypeOnly" Content="Tür"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
