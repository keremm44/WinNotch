<UserControl x:Class="WinNotch.TrayApp.AppearanceSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinNotch.TrayApp"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="ChoiceRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="{DynamicResource Metric.Settings.ControlHeight}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="{DynamicResource Metric.Settings.BodyFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Medium}"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Accent.Selection}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring"
                                Width="34" Height="34"
                                CornerRadius="17"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Border.Strong}"
                                BorderThickness="1">
                            <Grid>
                                <Ellipse x:Name="SelectionGlow"
                                         Width="30" Height="30"
                                         Fill="{TemplateBinding Background}"
                                         Opacity="0"/>
                                <Ellipse Width="22" Height="22"
                                         Fill="{TemplateBinding Background}"/>
                                <Ellipse Width="20" Height="20"
                                         Stroke="{DynamicResource Brush.Surface.Highlight}"
                                         StrokeThickness="1"
                                         IsHitTestVisible="False"/>
                                <Path x:Name="SelectedCheck"
                                      Data="{DynamicResource Icon.Check}"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Text.Secondary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <!-- Selection remains tied to this swatch's own color. -->
                                <Setter TargetName="Ring" Property="BorderBrush"
                                        Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="SelectionGlow" Property="Opacity" Value="0.16"/>
                                <Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Metric.Settings.BodyFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ChoiceGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style x:Key="AdvancedExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource Brush.Surface.Softer}"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Medium}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderButton"
                                              Height="40"
                                              Padding="12,0"
                                              HorizontalContentAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Cursor="Hand"
                                              FocusVisualStyle="{StaticResource Focus.Visual}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}"
                                                               FontSize="{DynamicResource Metric.Settings.BodyFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                                               VerticalAlignment="Center"/>
                                                    <Path x:Name="Chevron"
                                                          Data="{DynamicResource Icon.ChevronDown}"
                                                          Width="10" Height="6" Stretch="Fill"
                                                          Stroke="{DynamicResource Brush.Text.Muted}"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value><RotateTransform Angle="180" CenterX="5" CenterY="3"/></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  Grid.Row="1"
                                                  Margin="12,4,12,12"
                                                  Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Surface.Raised}"
            BorderBrush="{DynamicResource Brush.Border.Premium}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Large}"
            Padding="{DynamicResource Thickness.CardPadding}"
            Margin="0,0,0,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Width="28" Height="28" CornerRadius="8"
                        Background="{DynamicResource Brush.Accent.Subtle}"
                        BorderBrush="{DynamicResource Brush.Accent.Border}"
                        BorderThickness="1" Margin="0,0,10,0">
                    <Path Data="{DynamicResource Icon.Settings}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource Brush.Accent.Primary}" StrokeThickness="1.35"
                          StrokeLineJoin="Round"/>
                </Border>
                <TextBlock Text="Görünüm"
                           FontSize="{DynamicResource Metric.Settings.SectionFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="WinNotch görünümünü seç; önizleme gerçek çalışma yüzeyiyle birlikte güncellenir."
                       FontSize="{DynamicResource Metric.Settings.BodyFontSize}"
                       Foreground="{DynamicResource Brush.Text.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <local:AppearancePreviewView x:Name="AppearancePreview"/>

            <TextBlock Text="Tema" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource ChoiceGroup}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="ThemeObsidianRadio" Grid.Column="0"
                                 GroupName="ThemePreset" Tag="Obsidian" Content="Obsidyen"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="ThemeAuroraRadio" Grid.Column="1"
                                 GroupName="ThemePreset" Tag="Aurora" Content="Aurora"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="ThemeMonochromeRadio" Grid.Column="2"
                                 GroupName="ThemePreset" Tag="Monochrome" Content="Tek renk"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="ThemePaperRadio" Grid.Column="3"
                                 GroupName="ThemePreset" Tag="Paper" Content="Açık"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                </Grid>
            </Border>

            <TextBlock Text="Vurgu rengi" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="AccentBlueRadio" GroupName="AccentPreset" Tag="Blue"
                             Style="{StaticResource AccentRadio}" Background="#FF2D7DFF"
                             ToolTip="Mavi" AutomationProperties.Name="Mavi vurgu rengi" Checked="AppearanceRadio_Checked"/>
                <RadioButton x:Name="AccentVioletRadio" GroupName="AccentPreset" Tag="Violet"
                             Style="{StaticResource AccentRadio}" Background="#FF8C6CFF"
                             ToolTip="Mor" AutomationProperties.Name="Mor vurgu rengi" Checked="AppearanceRadio_Checked"/>
                <RadioButton x:Name="AccentCyanRadio" GroupName="AccentPreset" Foreground="#FF101114" Tag="Cyan"
                             Style="{StaticResource AccentRadio}" Background="#FF23B7C9"
                             ToolTip="Camgöbeği" AutomationProperties.Name="Camgöbeği vurgu rengi" Checked="AppearanceRadio_Checked"/>
                <RadioButton x:Name="AccentAmberRadio" GroupName="AccentPreset" Foreground="#FF101114" Tag="Amber"
                             Style="{StaticResource AccentRadio}" Background="#FFF0A43C"
                             ToolTip="Kehribar" AutomationProperties.Name="Kehribar vurgu rengi" Checked="AppearanceRadio_Checked"/>
                <RadioButton x:Name="AccentGreenRadio" GroupName="AccentPreset" Foreground="#FF101114" Tag="Green"
                             Style="{StaticResource AccentRadio}" Background="#FF35B982"
                             ToolTip="Yeşil" AutomationProperties.Name="Yeşil vurgu rengi" Checked="AppearanceRadio_Checked"/>
                <RadioButton x:Name="AccentSystemRadio" GroupName="AccentPreset" Tag="System" Foreground="{DynamicResource Brush.Accent.SystemForeground}"
                             Style="{StaticResource AccentRadio}" Background="{DynamicResource Brush.Accent.System}"
                             ToolTip="Windows sistem rengi" AutomationProperties.Name="Windows sistem vurgu rengi" Checked="AppearanceRadio_Checked"/>
                <TextBlock Text="Sistem" VerticalAlignment="Center"
                           FontSize="{DynamicResource Metric.Settings.CaptionFontSize}"
                           Foreground="{DynamicResource Brush.Text.Muted}"/>
            </StackPanel>

            <TextBlock Text="Yoğunluk" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource ChoiceGroup}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <RadioButton x:Name="DensityCompactRadio" Grid.Column="0"
                                 GroupName="DensityMode" Tag="Compact" Content="Kompakt"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="DensityComfortableRadio" Grid.Column="1"
                                 GroupName="DensityMode" Tag="Comfortable" Content="Rahat"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                </Grid>
            </Border>

            <TextBlock Text="Boşta görünümü" Style="{StaticResource FieldLabel}"/>
            <Border Style="{StaticResource ChoiceGroup}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <RadioButton x:Name="IdleLineRadio" Grid.Column="0"
                                 GroupName="IdleStyle" Tag="Line" Content="Çizgi"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="IdleDotRadio" Grid.Column="1"
                                 GroupName="IdleStyle" Tag="Dot" Content="Nokta"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                    <RadioButton x:Name="IdleAmbientRadio" Grid.Column="2"
                                 GroupName="IdleStyle" Tag="Ambient" Content="Ortam"
                                 Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                </Grid>
            </Border>

            <Expander Header="Gelişmiş görünüm seçenekleri"
                      Style="{StaticResource AdvancedExpander}"
                      IsExpanded="False">
                <StackPanel>
                    <TextBlock Text="Hareket" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource ChoiceGroup}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="MotionReducedRadio" Grid.Column="0"
                                         GroupName="MotionMode" Tag="Reduced" Content="Azaltılmış"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                            <RadioButton x:Name="MotionNormalRadio" Grid.Column="1"
                                         GroupName="MotionMode" Tag="Normal" Content="Normal"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Durum renkleri" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource ChoiceGroup}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="StateUnifiedRadio" Grid.Column="0"
                                         GroupName="StateAccentMode" Tag="Unified" Content="Tek renk"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                            <RadioButton x:Name="StateSemanticRadio" Grid.Column="1"
                                         GroupName="StateAccentMode" Tag="Semantic" Content="Bağlamsal"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="İçerik gizliliği" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource ChoiceGroup}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="PrivacyFullRadio" Grid.Column="0"
                                         GroupName="PrivacyPreviewMode" Tag="Full" Content="Tam"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                            <RadioButton x:Name="PrivacyMaskedRadio" Grid.Column="1"
                                         GroupName="PrivacyPreviewMode" Tag="Masked" Content="Maskeli"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                            <RadioButton x:Name="PrivacyTypeOnlyRadio" Grid.Column="2"
                                         GroupName="PrivacyPreviewMode" Tag="TypeOnly" Content="Yalnız tür"
                                         Style="{StaticResource ChoiceRadio}" Checked="AppearanceRadio_Checked"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
