<Application x:Class="WinNotch.TrayApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup"
             DispatcherUnhandledException="OnDispatcherUnhandledException">
    <!--
        WHY ShutdownMode="OnExplicitShutdown":
        We control when the app exits. Closing the main window
        should NOT exit the app — only the tray menu "Exit" option
        or Application.Current.Shutdown() should exit.
    -->

    <Application.Resources>
        <!-- Global resource dictionary for common styles -->
        <ResourceDictionary>
            <!-- Dark theme colors -->
            <SolidColorBrush x:Key="BackgroundDark" Color="#FF1E1E1E"/>
            <SolidColorBrush x:Key="ForegroundLight" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="AccentBlue" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#99FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
