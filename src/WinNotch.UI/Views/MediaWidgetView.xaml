<UserControl x:Class="WinNotch.UI.Views.MediaWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFFFFFFF">

    <!--
        Media Widget View (Module C)
        Shows album art, song info, and playback controls.
        Active only when SMTC reports an active media session.
    -->

    <Grid Margin="10,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Album Art Thumbnail -->
        <Border Grid.Column="0"
                Width="48" Height="48"
                CornerRadius="6"
                ClipToBounds="True"
                Margin="0,0,10,0"
                VerticalAlignment="Center">
            <Border.Background>
                <SolidColorBrush Color="#FF333333"/>
            </Border.Background>
            <Image x:Name="AlbumArtImage"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <!-- Song Info -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
            <TextBlock x:Name="TitleText"
                       Text="Şarkı Adı"
                       Foreground="#FFFFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="160"/>
            <TextBlock x:Name="ArtistText"
                       Text="Sanatçı"
                       Foreground="#99FFFFFF"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="160"
                       Margin="0,1,0,0"/>
        </StackPanel>

        <!-- Playback Controls -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Button x:Name="PrevButton"
                    Content="⏮"
                    FontSize="14"
                    Background="Transparent"
                    Foreground="#CCFFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="4,2"
                    Click="PrevButton_Click"
                    ToolTip="Önceki şarkı"/>

            <Button x:Name="PlayPauseButton"
                    Content="▶"
                    FontSize="16"
                    Background="Transparent"
                    Foreground="#FFFFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="4,2"
                    Margin="2,0"
                    Click="PlayPauseButton_Click"
                    ToolTip="Oynat/Duraklat"/>

            <Button x:Name="NextButton"
                    Content="⏭"
                    FontSize="14"
                    Background="Transparent"
                    Foreground="#CCFFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="4,2"
                    Click="NextButton_Click"
                    ToolTip="Sonraki şarkı"/>
        </StackPanel>
    </Grid>
</UserControl>
