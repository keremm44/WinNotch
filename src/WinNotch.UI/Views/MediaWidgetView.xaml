<UserControl x:Class="WinNotch.UI.Views.MediaWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Brush.Text.Primary}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="MediaControlButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.OnDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDarkPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Soft}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Thickness.ViewPadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="AlbumArtSurface"
                Grid.Column="0"
                Width="40" Height="40"
                CornerRadius="8"
                ClipToBounds="True"
                BorderBrush="{DynamicResource Brush.State.Media.Border}"
                BorderThickness="1"
                Background="{DynamicResource Brush.State.Media.Subtle}"
                Margin="0,0,10,0"
                VerticalAlignment="Center">
            <Grid>
                <Path Data="{DynamicResource Icon.Media}"
                      Width="16" Height="16"
                      Stretch="Uniform"
                      Stroke="{DynamicResource Brush.State.Media}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
                <Image x:Name="AlbumArtImage"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Height="13"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#24FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              VerticalAlignment="Center"
              Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Text="Medya"
                       Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="142"/>
            <TextBlock x:Name="SubtitleText"
                       Grid.Row="1"
                       Text=""
                       Foreground="{DynamicResource Brush.Text.OnDarkSecondary}"
                       FontSize="8.8"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="142"
                       Margin="0,1,0,0"/>
            <Border x:Name="ProgressTrack"
                    Grid.Row="2"
                    Height="3"
                    CornerRadius="1.5"
                    Background="{DynamicResource Brush.Surface.Soft}"
                    Margin="0,5,0,0"
                    SizeChanged="ProgressTrack_SizeChanged">
                <Border x:Name="ProgressFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        CornerRadius="1.5"
                        Background="{DynamicResource Brush.State.Media}"/>
            </Border>
        </Grid>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Button x:Name="PrevButton"
                    Style="{StaticResource MediaControlButton}"
                    Content="⏮"
                    Click="PrevButton_Click"
                    ToolTip="Önceki"/>

            <Button x:Name="PlayPauseButton"
                    Style="{StaticResource MediaControlButton}"
                    Width="34" Height="34"
                    Background="{DynamicResource Brush.State.Media.Subtle}"
                    BorderBrush="{DynamicResource Brush.State.Media.Border}"
                    Content="▶"
                    FontSize="14"
                    Click="PlayPauseButton_Click"
                    ToolTip="Oynat / duraklat"/>

            <Button x:Name="NextButton"
                    Style="{StaticResource MediaControlButton}"
                    Content="⏭"
                    Click="NextButton_Click"
                    ToolTip="Sonraki"/>
        </StackPanel>
    </Grid>
</UserControl>
