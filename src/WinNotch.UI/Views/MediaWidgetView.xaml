<UserControl x:Class="WinNotch.UI.Views.MediaWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFFFFFFF"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="MediaControlButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E8FFFFFF"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#36FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="40" Height="40"
                CornerRadius="8"
                ClipToBounds="True"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                Background="#FF202024"
                Margin="0,0,10,0"
                VerticalAlignment="Center">
            <Grid>
                <TextBlock Text="♪"
                           FontSize="16"
                           Foreground="#5AFFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Image x:Name="AlbumArtImage"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
            <TextBlock x:Name="TitleText"
                       Text="Medya"
                       Foreground="#F4FFFFFF"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="150"/>
            <TextBlock x:Name="ArtistText"
                       Text=""
                       Foreground="#82FFFFFF"
                       FontSize="9.5"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="150"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Button x:Name="PrevButton"
                    Style="{StaticResource MediaControlButton}"
                    Content="⏮"
                    Click="PrevButton_Click"
                    ToolTip="Önceki"/>

            <Button x:Name="PlayPauseButton"
                    Style="{StaticResource MediaControlButton}"
                    Width="34" Height="34"
                    Content="▶"
                    FontSize="14"
                    Click="PlayPauseButton_Click"
                    ToolTip="Oynat / duraklat"/>

            <Button x:Name="NextButton"
                    Style="{StaticResource MediaControlButton}"
                    Content="⏭"
                    Click="NextButton_Click"
                    ToolTip="Sonraki"/>
        </StackPanel>
    </Grid>
</UserControl>
