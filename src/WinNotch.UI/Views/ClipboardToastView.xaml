<UserControl x:Class="WinNotch.UI.Views.ClipboardToastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Brush.Text.Primary}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             MouseEnter="Surface_MouseEnter"
             MouseLeave="Surface_MouseLeave">
    <UserControl.Resources>
        <Style x:Key="ContextActionButton" TargetType="Button">
            <Setter Property="Height" Value="{DynamicResource Metric.ControlHeight}"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Foreground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Accent.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Accent.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Thickness.CompactPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="MainRow" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="StatusSurface"
                    Grid.Column="0"
                    Width="24" Height="24"
                    CornerRadius="7"
                    Background="{DynamicResource Brush.Surface.Soft}"
                    BorderBrush="{DynamicResource Brush.Border.OnDark}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <Grid>
                    <Border x:Name="ColorSwatch"
                            Margin="4"
                            CornerRadius="4"
                            Visibility="Collapsed"/>
                    <Path x:Name="StatusIconPath"
                          Data="{DynamicResource Icon.Copy}"
                          Width="13" Height="13"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Brush.Text.OnDarkPrimary}"
                          StrokeThickness="1.45"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border x:Name="ImagePreviewBorder"
                    Grid.Column="1"
                    Width="38" Height="38"
                    CornerRadius="8"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource Brush.Border.OnDarkStrong}"
                    BorderThickness="1"
                    Background="{DynamicResource Brush.Surface.Control}"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Image x:Name="ImagePreview"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Margin="8,0,8,0">
                <TextBlock x:Name="PreviewText"
                           Text="Panoya alındı"
                           Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180"/>
                <TextBlock x:Name="DetailText"
                           Text=""
                           Foreground="{DynamicResource Brush.Text.OnDarkSecondary}"
                           FontSize="8.5"
                           Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180"/>
            </StackPanel>

            <TextBlock Grid.Column="3"
                       x:Name="TimestampText"
                       Text="şimdi"
                       Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                       FontSize="8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid x:Name="ActionPanel"
              Grid.Row="1"
              Margin="0,3,0,0"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="1"
                    Margin="2,0"
                    Background="{DynamicResource Brush.Border.OnDark}"/>

            <Grid Grid.Row="1" Margin="1,3,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ActionHintText"
                           Text="İçerik için aksiyon hazır"
                           FontSize="9"
                           Foreground="{DynamicResource Brush.Text.OnDarkSecondary}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="2,0,10,0"/>
                <Button x:Name="PrimaryActionButton"
                        Grid.Column="1"
                        Style="{StaticResource ContextActionButton}"
                        Content="Aç"
                        Click="PrimaryActionButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
