<UserControl x:Class="WinNotch.UI.Views.ClipboardToastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFFFFFFF">

    <!--
        Clipboard Toast View (Module B/E)
        Brief flash notification when clipboard content changes.
        Shows text preview or image thumbnail.
        Auto-dismisses after 1.5 seconds.
    -->

    <Grid Margin="8,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Status icon -->
        <TextBlock Grid.Column="0"
                   x:Name="StatusIcon"
                   Text="📋"
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0"/>

        <!-- Content preview -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">
            <TextBlock x:Name="PreviewText"
                       Text="Panoya kopyalandı ✓"
                       Foreground="#CCFFFFFF"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="180"/>

            <!-- Image thumbnail preview -->
            <Border x:Name="ImagePreviewBorder"
                    Width="32" Height="32"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Margin="0,3,0,0"
                    Visibility="Collapsed">
                <Border.Background>
                    <SolidColorBrush Color="#FF333333"/>
                </Border.Background>
                <Image x:Name="ImagePreview"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </StackPanel>

        <!-- Timestamp -->
        <TextBlock Grid.Column="1"
                   x:Name="TimestampText"
                   Text="şimdi"
                   Foreground="#66FFFFFF"
                   FontSize="8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,0,0"/>
    </Grid>
</UserControl>
