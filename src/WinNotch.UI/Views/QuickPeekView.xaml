<UserControl x:Class="WinNotch.UI.Views.QuickPeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="QuickPeekContextButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Soft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDarkPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.OnDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background"
                                        Value="{DynamicResource Brush.Surface.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Thickness.ViewPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="WinNotch"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                       VerticalAlignment="Top"/>
            <TextBlock Text="Hızlı görünüm"
                       FontSize="8"
                       Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"/>
        </Grid>

        <Button x:Name="ContextButton"
                Grid.Row="1"
                Height="42"
                Visibility="Collapsed"
                Style="{StaticResource QuickPeekContextButton}"
                Click="ContextButton_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ContextStatusSurface"
                        Width="24" Height="24"
                        CornerRadius="6"
                        Background="{DynamicResource Brush.State.Clipboard.Subtle}"
                        BorderBrush="{DynamicResource Brush.State.Clipboard.Border}"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Path x:Name="ContextIconPath"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Brush.State.Clipboard}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="7,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ContextPreviewText"
                               Text="—"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="215"/>
                    <TextBlock x:Name="ContextKindText"
                               Text="Son pano"
                               FontSize="8.5"
                               Foreground="{DynamicResource Brush.Text.OnDarkSecondary}"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <Path Grid.Column="2"
                      Data="M 0 0 L 4 4 L 0 8"
                      Width="4" Height="8"
                      Stretch="Fill"
                      Stroke="{DynamicResource Brush.Text.OnDarkMuted}"
                      StrokeThickness="1.3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Grid>
        </Button>

        <Grid x:Name="EmptyPanel" Grid.Row="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Dosya bırak veya bağlantı kopyala"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.OnDarkSecondary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Anlamlı bağlam burada görünür"
                           FontSize="8"
                           Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
