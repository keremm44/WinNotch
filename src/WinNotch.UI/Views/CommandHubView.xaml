<UserControl x:Class="WinNotch.UI.Views.CommandHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="HubCommandButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Soft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDarkPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.OnDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}"/>
                                <Setter TargetName="Surface" Property="BorderBrush"
                                        Value="{DynamicResource Brush.Accent.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background"
                                        Value="{DynamicResource Brush.Surface.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubIconSurface" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,6,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="3" Height="11" CornerRadius="1.5"
                        Background="{DynamicResource Brush.Accent.Primary}" Margin="0,0,6,0"/>
                <TextBlock Text="Komut Merkezi" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
            </StackPanel>
            <TextBlock Text="Sol tık araçları" FontSize="9"
                       Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ClipboardButton" Grid.Column="0"
                    Style="{StaticResource HubCommandButton}"
                    Click="ClipboardButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource HubIconSurface}">
                        <Path Data="{DynamicResource Icon.Copy}" Width="12" Height="12"
                              Stretch="Uniform" Stroke="{DynamicResource Brush.Accent.Primary}"
                              StrokeThickness="1.35" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="Pano" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                        <TextBlock x:Name="ClipboardHintText" Text="Bağlam yok" FontSize="8.5"
                                   Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="ShelfButton" Grid.Column="2"
                    Style="{StaticResource HubCommandButton}"
                    Click="ShelfButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource HubIconSurface}">
                        <Path Data="{DynamicResource Icon.Folder}" Width="12" Height="12"
                              Stretch="Uniform" Stroke="{DynamicResource Brush.Accent.Primary}"
                              StrokeThickness="1.35" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="Dosyalar" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                        <TextBlock x:Name="ShelfHintText" Text="Raf boş" FontSize="8.5"
                                   Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource HubCommandButton}"
                    Click="SettingsButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource HubIconSurface}">
                        <Path Data="{DynamicResource Icon.Settings}" Width="12" Height="12"
                              Stretch="Uniform" Stroke="{DynamicResource Brush.Accent.Primary}"
                              StrokeThickness="1.25" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="Ayarlar" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                        <TextBlock Text="WinNotch" FontSize="8.5"
                                   Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
