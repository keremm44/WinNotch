<UserControl x:Class="WinNotch.UI.Views.CommandHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="HubCommandButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Soft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDarkPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.OnDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="7,5">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.38"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubCompactButton" TargetType="Button" BasedOn="{StaticResource HubCommandButton}">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="HubBackButton" TargetType="Button" BasedOn="{StaticResource HubCompactButton}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style x:Key="HubChoiceItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDarkPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.OnDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubChoiceList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource HubChoiceItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubIconSurface" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,6,10,8">
        <Grid x:Name="HubHomePanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="52"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Width="3" Height="11" CornerRadius="1.5"
                            Background="{DynamicResource Brush.Accent.Primary}" Margin="0,0,6,0"/>
                    <TextBlock Text="Komut Merkezi" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                </StackPanel>
                <TextBlock Text="Hızlı araçlar" FontSize="9"
                           Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ClipboardButton" Grid.Column="0" Style="{StaticResource HubCommandButton}"
                        Click="ClipboardButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HubIconSurface}">
                            <Path Data="{DynamicResource Icon.Copy}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Accent.Primary}" StrokeThickness="1.35"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="Pano" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                            <TextBlock x:Name="ClipboardHintText" Text="Bağlam yok" FontSize="8.5"
                                       Foreground="{DynamicResource Brush.Text.OnDarkMuted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="ShelfButton" Grid.Column="2" Style="{StaticResource HubCommandButton}" Click="ShelfButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HubIconSurface}">
                            <Path Data="{DynamicResource Icon.Folder}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Accent.Primary}" StrokeThickness="1.35"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="Dosyalar" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                            <TextBlock x:Name="ShelfHintText" Text="Raf boş" FontSize="8.5" Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource HubCommandButton}" Click="SettingsButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource HubIconSurface}">
                            <Path Data="{DynamicResource Icon.Settings}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Accent.Primary}" StrokeThickness="1.25"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="Ayarlar" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                            <TextBlock Text="WinNotch" FontSize="8.5" Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource HubCompactButton}" Click="SmartClipboardButton_Click">
                    <StackPanel><TextBlock Text="Akıllı Pano" FontWeight="SemiBold"/><TextBlock Text="Metni dönüştür" FontSize="8" Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/></StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource HubCompactButton}" Click="TemporaryNoteButton_Click">
                    <StackPanel><TextBlock Text="Not" FontWeight="SemiBold"/><TextBlock Text="Geçici taslak" FontSize="8" Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/></StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource HubCompactButton}" Click="TimerButton_Click">
                    <StackPanel><TextBlock Text="Zamanlayıcı" FontWeight="SemiBold"/><TextBlock x:Name="TimerHomeHintText" Text="Hazır" FontSize="8" Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/></StackPanel>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource HubCompactButton}" Click="QrButton_Click">
                    <StackPanel><TextBlock Text="QR" FontWeight="SemiBold"/><TextBlock Text="Kod oluştur" FontSize="8" Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/></StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="SmartClipboardPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/><RowDefinition Height="52"/>
                <RowDefinition Height="70"/><RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Button Style="{StaticResource HubBackButton}"
                        Content="← Geri" Click="SmartClipboardBackButton_Click"/>
                <TextBlock Text="Akıllı Pano" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                <TextBlock x:Name="SmartClipboardStatusText" Text="Panodan metin alınıyor" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="8.5" Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/>
            </Grid>

            <TextBox x:Name="SmartClipboardInput" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="7,4" FontSize="9"
                     Background="{DynamicResource Brush.Surface.Soft}" Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                     BorderBrush="{DynamicResource Brush.Border.OnDark}" BorderThickness="1"/>

            <ListBox x:Name="TransformKindList" Grid.Row="2" SelectedIndex="0" FontSize="8.5"
                     Style="{StaticResource HubChoiceList}"
                     SelectionChanged="TransformKindList_SelectionChanged">
                <ListBoxItem Content="Boşluk temizle" Tag="CleanWhitespace"/>
                <ListBoxItem Content="BÜYÜK HARF" Tag="Uppercase"/>
                <ListBoxItem Content="küçük harf" Tag="Lowercase"/>
                <ListBoxItem Content="Başlık Biçimi" Tag="TitleCase"/>
                <ListBoxItem Content="JSON düzenle" Tag="PrettyJson"/>
                <ListBoxItem Content="URL kodla" Tag="UrlEncode"/>
                <ListBoxItem Content="URL çöz" Tag="UrlDecode"/>
            </ListBox>

            <TextBox x:Name="SmartClipboardOutput" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="7,4" FontSize="9"
                     Background="{DynamicResource Brush.Surface.Soft}" Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                     BorderBrush="{DynamicResource Brush.Accent.Border}" BorderThickness="1"/>
            <Button x:Name="CopyTransformButton" Grid.Row="4" Width="92" HorizontalAlignment="Right"
                    Margin="0,5,0,0" Style="{StaticResource HubCompactButton}"
                    Content="Sonucu kopyala" Click="CopyTransformButton_Click"/>
        </Grid>

        <Grid x:Name="TemporaryNotePanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Button Style="{StaticResource HubBackButton}"
                        Content="← Geri" Click="TemporaryNoteBackButton_Click"/>
                <TextBlock Text="Geçici Not" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                <TextBlock x:Name="TemporaryNoteStatusText" Text="Bu oturumda saklanır"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8.5"
                           Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/>
            </Grid>
            <TextBox x:Name="TemporaryNoteTextBox" Grid.Row="1" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="10000"
                     Padding="7,5" FontSize="9" TextChanged="TemporaryNoteTextBox_TextChanged"
                     Background="{DynamicResource Brush.Surface.Soft}"
                     Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                     CaretBrush="{DynamicResource Brush.Accent.Primary}"
                     BorderBrush="{DynamicResource Brush.Accent.Border}" BorderThickness="1"/>
            <Grid Grid.Row="2" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="72"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Uygulama kapanınca silinir" FontSize="8.5"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/>
                <Button Grid.Column="2" Style="{StaticResource HubCompactButton}"
                        Content="Temizle" Click="ClearTemporaryNoteButton_Click"/>
                <Button Grid.Column="4" Style="{StaticResource HubCompactButton}"
                        Content="Kopyala" Click="CopyTemporaryNoteButton_Click"/>
            </Grid>
        </Grid>

        <Grid x:Name="TimerPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/><RowDefinition Height="58"/>
                <RowDefinition Height="42"/><RowDefinition Height="42"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Button Style="{StaticResource HubBackButton}"
                        Content="← Geri" Click="TimerBackButton_Click"/>
                <TextBlock Text="Zamanlayıcı" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                <TextBlock x:Name="TimerStatusText" Text="Hazır" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="8.5" Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/>
            </Grid>
            <TextBlock x:Name="TimerRemainingText" Grid.Row="1" Text="05:00" FontSize="28" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
            <ListBox x:Name="TimerPresetList" Grid.Row="2" SelectedIndex="1" FontSize="9"
                     Style="{StaticResource HubChoiceList}"
                     SelectionChanged="TimerPresetList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem Content="1 dk" Tag="1"/><ListBoxItem Content="5 dk" Tag="5"/>
                <ListBoxItem Content="10 dk" Tag="10"/><ListBoxItem Content="25 dk" Tag="25"/>
                <ListBoxItem Content="60 dk" Tag="60"/>
            </ListBox>
            <Grid Grid.Row="3" Margin="2,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TimerCustomMinutesTextBox" Grid.Column="0" Text="5" MaxLength="4"
                         VerticalContentAlignment="Center" Padding="8,4" FontSize="9"
                         Background="{DynamicResource Brush.Surface.Soft}"
                         Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                         CaretBrush="{DynamicResource Brush.Accent.Primary}"
                         BorderBrush="{DynamicResource Brush.Border.OnDark}" BorderThickness="1"
                         ToolTip="1–1440 dakika"/>
                <Button x:Name="TimerStartButton" Grid.Column="2" Style="{StaticResource HubCompactButton}"
                        Content="Başlat" Click="TimerStartButton_Click"/>
            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="TimerPauseButton" Grid.Column="0" Style="{StaticResource HubCompactButton}"
                        Content="Duraklat" IsEnabled="False" Click="TimerPauseButton_Click"/>
                <Button x:Name="TimerCancelButton" Grid.Column="2" Style="{StaticResource HubCompactButton}"
                        Content="İptal" IsEnabled="False" Click="TimerCancelButton_Click"/>
            </Grid>
        </Grid>

        <Grid x:Name="QrPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/><RowDefinition Height="62"/>
                <RowDefinition Height="40"/><RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Button Style="{StaticResource HubBackButton}"
                        Content="← Geri" Click="QrBackButton_Click"/>
                <TextBlock Text="QR Oluştur" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"/>
                <TextBlock x:Name="QrStatusText" Text="Metin girin" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="8.5" Foreground="{DynamicResource Brush.Text.OnDarkMuted}"/>
            </Grid>
            <TextBox x:Name="QrInputTextBox" Grid.Row="1" AcceptsReturn="True" MaxLength="2048"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="7,5" FontSize="9"
                     Background="{DynamicResource Brush.Surface.Soft}" Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                     CaretBrush="{DynamicResource Brush.Accent.Primary}"
                     BorderBrush="{DynamicResource Brush.Accent.Border}" BorderThickness="1"/>
            <Grid Grid.Row="2" Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource HubCompactButton}" Content="Panodan al"
                        Click="QrPasteButton_Click"/>
                <Button Grid.Column="2" Style="{StaticResource HubCompactButton}" Content="QR oluştur"
                        Click="QrGenerateButton_Click"/>
            </Grid>
            <Border Grid.Row="3" Width="132" Height="132" HorizontalAlignment="Center"
                    Background="White" CornerRadius="4" Padding="5">
                <Image x:Name="QrPreviewImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
            </Border>
            <Grid Grid.Row="4" Margin="0,5,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="QrCopyButton" Grid.Column="0" Style="{StaticResource HubCompactButton}"
                        Content="Görseli kopyala" IsEnabled="False" Click="QrCopyButton_Click"/>
                <Button x:Name="QrSaveButton" Grid.Column="2" Style="{StaticResource HubCompactButton}"
                        Content="PNG kaydet" IsEnabled="False" Click="QrSaveButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
