<UserControl x:Class="WinNotch.UI.Views.DropZoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFFFFFFF">
    <Grid Margin="8,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compact persistent shelf surface. Drag this row back out to another app. -->
        <Grid x:Name="DragHandle"
              Grid.Row="0"
              Cursor="Hand"
              PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
              PreviewMouseMove="DragHandle_MouseMove">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="24" Height="24" CornerRadius="6"
                    Background="#1FFFFFFF" VerticalAlignment="Center">
                <TextBlock x:Name="FileIcon" Text="F" FontSize="10"
                           FontWeight="SemiBold" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="#DDFFFFFF"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="7,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="DropTargetText"
                           Text="Dosyayı buraya bırak"
                           FontSize="10.5" FontWeight="SemiBold"
                           Foreground="#F0FFFFFF"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="FileSummaryText"
                           FontSize="8.5" Foreground="#8FFFFFFF"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button x:Name="RemoveButton" Grid.Column="2"
                    Content="×" Width="24" Height="24"
                    FontSize="15" Padding="0" BorderThickness="0"
                    Background="Transparent" Foreground="#99FFFFFF"
                    Visibility="Collapsed" Cursor="Hand"
                    ToolTip="Shelf'i temizle"
                    Click="RemoveButton_Click"/>
        </Grid>

        <!-- Primary transfer actions. Hidden in compact ShelfOccupied state. -->
        <StackPanel x:Name="ActionButtons" Grid.Row="1"
                    Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,5,0,0" Visibility="Collapsed">
            <Button x:Name="CopyFilesButton" Content="Copy files"
                    FontSize="9" Padding="8,2" Margin="0,0,4,0"
                    BorderThickness="0" Background="#26FFFFFF"
                    Foreground="White" Cursor="Hand"
                    ToolTip="Windows dosya panosuna kopyala; Explorer'da Ctrl+V ile yapıştır"
                    Click="CopyFilesButton_Click"/>
            <Button x:Name="OpenFolderButton" Content="Open"
                    FontSize="9" Padding="8,2" Margin="0,0,4,0"
                    BorderThickness="0" Background="#26FFFFFF"
                    Foreground="White" Cursor="Hand"
                    Click="OpenFolderButton_Click"/>
            <Button x:Name="MoreButton" Content="•••"
                    FontSize="9" Padding="8,2"
                    BorderThickness="0" Background="#26FFFFFF"
                    Foreground="White" Cursor="Hand"
                    Click="MoreButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
