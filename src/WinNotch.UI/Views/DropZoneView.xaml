<UserControl x:Class="WinNotch.UI.Views.DropZoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFFFFFFF">

    <!--
        Drop Zone View (Module A)
        Shows when files are dragged over or dropped on the notch.
        Provides contextual actions: copy path, open folder, open terminal.
    -->

    <Grid Margin="8,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: File info summary — compact -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="FileIcon" Text="📁" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="DropTargetText"
                           Text="Dosyaları buraya bırakın"
                           Foreground="#CCFFFFFF"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220"/>
                <TextBlock x:Name="FileSummaryText"
                           Text=""
                           Foreground="#80FFFFFF"
                           FontSize="9"
                           Margin="0,1,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Row 1: Action buttons (visible after drop) -->
        <StackPanel x:Name="ActionButtons"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,4,0,0"
                    Visibility="Collapsed">
            <Button x:Name="CopyPathButton"
                    Content="📋 Copy"
                    FontSize="9"
                    Padding="6,2"
                    Margin="0,0,3,0"
                    Background="#33FFFFFF"
                    Foreground="#FFFFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CopyPathButton_Click"/>
            <Button x:Name="OpenFolderButton"
                    Content="📂 Folder"
                    FontSize="9"
                    Padding="6,2"
                    Margin="0,0,3,0"
                    Background="#33FFFFFF"
                    Foreground="#FFFFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OpenFolderButton_Click"/>
            <Button x:Name="TerminalButton"
                    Content="💻 Terminal"
                    FontSize="9"
                    Padding="6,2"
                    Background="#33FFFFFF"
                    Foreground="#FFFFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="TerminalButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
