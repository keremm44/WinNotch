<UserControl x:Class="WinNotch.UI.Views.DropZoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFFFFFFF"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="ShelfActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="#E8FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#24FFFFFF"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#34FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DragHandle"
              Grid.Row="0"
              Cursor="Hand"
              PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
              PreviewMouseMove="DragHandle_MouseMove">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="28" Height="28"
                    CornerRadius="8"
                    Background="#14FFFFFF"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock x:Name="FileIcon"
                           Text="+"
                           FontSize="9.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#E8FFFFFF"/>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="8,0,8,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="DropTargetText"
                           Text="Dosyayı buraya bırak"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           Foreground="#F2FFFFFF"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="FileSummaryText"
                           FontSize="8.5"
                           Foreground="#86FFFFFF"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,1,0,0"/>
            </StackPanel>

            <Button x:Name="RemoveButton"
                    Grid.Column="2"
                    Content="×"
                    Width="26" Height="26"
                    FontSize="15"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="#88FFFFFF"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="Rafı temizle"
                    Click="RemoveButton_Click"/>
        </Grid>

        <StackPanel x:Name="ActionButtons"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"
                    Visibility="Collapsed">
            <Button x:Name="CopyFilesButton"
                    Style="{StaticResource ShelfActionButton}"
                    Content="Kopyala"
                    ToolTip="Dosyaları Windows panosuna koy; Explorer'da Ctrl+V ile yapıştır"
                    Click="CopyFilesButton_Click"/>
            <Button x:Name="OpenFolderButton"
                    Style="{StaticResource ShelfActionButton}"
                    Content="Göster"
                    ToolTip="İlk öğeyi Dosya Gezgini'nde göster"
                    Click="OpenFolderButton_Click"/>
            <Button x:Name="MoreButton"
                    Style="{StaticResource ShelfActionButton}"
                    Content="•••"
                    Margin="0"
                    Click="MoreButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
