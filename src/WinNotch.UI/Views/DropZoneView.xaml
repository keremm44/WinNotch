<UserControl x:Class="WinNotch.UI.Views.DropZoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#FFFFFFFF">

    <!--
        Drop Zone View (Module A)
        Shows when files are dragged over the notch.
        Displays file paths and history.
    -->

    <Grid Margin="12,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Drop indicator icon -->
        <TextBlock Grid.Column="0"
                   Text="📁"
                   FontSize="20"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>

        <!-- File info panel -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">

            <!-- Current drop target -->
            <TextBlock x:Name="DropTargetText"
                       Text="Dosyaları buraya bırakın"
                       Foreground="#CCFFFFFF"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="300"/>

            <!-- History list (last 5) -->
            <ItemsControl x:Name="HistoryList"
                          MaxHeight="60"
                          Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayPath}"
                                   Foreground="#80FFFFFF"
                                   FontSize="9"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="280"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="HistoryItem_Click"
                                   Tag="{Binding FilePath}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
