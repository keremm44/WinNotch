<UserControl x:Class="WinNotch.UI.Views.DropZoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Brush.Text.Primary}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="ShelfActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="MinHeight" Value="{DynamicResource Metric.ControlHeight}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.OnDark}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Soft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDarkPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Border.OnDarkStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShelfChipButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.OnDark}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Soft}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDarkPrimary}"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipSurface"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipSurface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShelfChipRemoveButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDarkMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RemoveSurface"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveSurface" Property="Background" Value="{DynamicResource Brush.Semantic.DangerSubtle}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Semantic.Danger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Thickness.CompactPadding}">
        <Grid.RowDefinitions>
            <!-- The primary row consumes the exact remaining state height. This keeps
                 compact/drop states vertically centered while expanded shelf rows retain
                 their explicit desired heights instead of leaving bottom-only slack. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DragHandle"
              Grid.Row="0"
              Cursor="Hand"
              PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
              PreviewMouseMove="DragHandle_HardenedMouseMove">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="FileIconSurface"
                    Width="28" Height="28"
                    CornerRadius="8"
                    Background="{DynamicResource Brush.Surface.Soft}"
                    BorderBrush="{DynamicResource Brush.Border.OnDark}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <Grid>
                    <Path x:Name="FileAddIcon"
                          Data="{DynamicResource Icon.Add}"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Brush.Text.OnDarkPrimary}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="FileIcon"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="8,0,8,0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="DropTargetText"
                           Text="Dosyayı buraya bırak"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.OnDarkPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="FileSummaryText"
                           FontSize="9.5"
                           Foreground="{DynamicResource Brush.Text.OnDarkSecondary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,1,0,0"/>
            </StackPanel>

            <Button x:Name="RemoveButton"
                    Grid.Column="2"
                    Content="×"
                    Width="26" Height="26"
                    FontSize="15"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="{DynamicResource Brush.Text.OnDarkMuted}"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="Rafı temizle"
                    Click="RemoveButton_Click"/>
        </Grid>

        <StackPanel x:Name="ShelfChipsPanel"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0"
                    Visibility="Collapsed"/>

        <StackPanel x:Name="ActionButtons"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0"
                    Visibility="Collapsed">
            <Button x:Name="CopyFilesButton"
                    Style="{StaticResource ShelfActionButton}"
                    Content="Kopyala"
                    ToolTip="Dosyaları Windows panosuna koy; Explorer'da Ctrl+V ile yapıştır"
                    Click="CopyFilesButton_Click"/>
            <Button x:Name="OpenFolderButton"
                    Style="{StaticResource ShelfActionButton}"
                    Content="Göster"
                    ToolTip="Seçili öğeyi Dosya Gezgini'nde göster"
                    Click="OpenFolderButton_Click"/>
            <Button x:Name="MoreButton"
                    Style="{StaticResource ShelfActionButton}"
                    Margin="0"
                    ToolTip="Daha fazla"
                    AutomationProperties.Name="Daha fazla işlem"
                    Click="MoreButton_Click">
                <Path Data="{DynamicResource Icon.More}" Width="14" Height="4" Stretch="Fill"
                      Fill="{DynamicResource Brush.Text.OnDarkPrimary}"/>
            </Button>
        </StackPanel>
        <Border Height="1"
                VerticalAlignment="Bottom"
                Margin="8,0"
                Background="{DynamicResource Brush.State.File}"
                Opacity="0.55"
                IsHitTestVisible="False"/>
    </Grid>
</UserControl>
