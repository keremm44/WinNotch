<Window x:Class="WinNotch.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinNotch.UI.Views"
        Title="WinNotch"
        Width="100" Height="22"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource Brush.Notch.Base}"
        AllowsTransparency="False"
        Cursor="Arrow"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Closing="MainWindow_Closing"
        Loaded="MainWindow_Loaded">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseEnter="RootGrid_MouseEnter"
          MouseLeave="RootGrid_MouseLeave"
          AllowDrop="True"
          Drop="RootGrid_Drop"
          DragEnter="RootGrid_DragEnter"
          DragLeave="RootGrid_DragLeave"
          DragOver="RootGrid_DragOver">

        <Border x:Name="NotchBorder"
                Background="{DynamicResource Brush.Notch.Base}"
                CornerRadius="{DynamicResource Radius.Notch}"
                ClipToBounds="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <StackPanel x:Name="IdleContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="18" Height="3"
                            CornerRadius="1.5"
                            Background="{DynamicResource Brush.Notch.Handle}"/>
                </StackPanel>

                <StackPanel x:Name="MediaAmbientContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="16" Height="16"
                            CornerRadius="8"
                            Background="{DynamicResource Brush.Notch.AmbientSurface}"
                            Margin="0,0,5,0">
                        <TextBlock Text="▶"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="7"
                                   Foreground="{DynamicResource Brush.Notch.AmbientIcon}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="1,0,0,0"/>
                    </Border>
                    <TextBlock x:Name="MediaAmbientTitle"
                               Text="Medya"
                               FontSize="9"
                               Foreground="{DynamicResource Brush.Notch.AmbientText}"
                               MaxWidth="82"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <views:DropZoneView x:Name="DropZoneView"
                                    Visibility="Collapsed"/>

                <views:MediaWidgetView x:Name="MediaWidgetView"
                                       Visibility="Collapsed"/>

                <views:ClipboardToastView x:Name="ClipboardToastView"
                                          Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border x:Name="ThemeBorder"
                BorderBrush="{DynamicResource Brush.Border.LightTheme}"
                BorderThickness="1,0,1,1"
                CornerRadius="{DynamicResource Radius.Notch}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
    </Grid>
</Window>
