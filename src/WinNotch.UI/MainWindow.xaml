<Window x:Class="WinNotch.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinNotch.UI.Views"
        Title="WinNotch"
        Width="100" Height="22"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF000000"
        AllowsTransparency="False"
        Cursor="Arrow"
        Closing="MainWindow_Closing"
        Loaded="MainWindow_Loaded">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseEnter="RootGrid_MouseEnter"
          MouseLeave="RootGrid_MouseLeave"
          AllowDrop="True"
          Drop="RootGrid_Drop"
          DragEnter="RootGrid_DragEnter"
          DragLeave="RootGrid_DragLeave"
          DragOver="RootGrid_DragOver"
          MouseRightButtonUp="RootGrid_MouseRightButtonUp">

        <!--
            Geometry is owned by the Window/state machine. These borders stretch to
            the current HWND size instead of remaining stuck at the 100x22 idle size.
        -->
        <Border x:Name="NotchBorder"
                Background="#FF000000"
                CornerRadius="11"
                ClipToBounds="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <StackPanel x:Name="IdleContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="1">
                    <TextBlock Text="•"
                               Foreground="#66FFFFFF"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <views:DropZoneView x:Name="DropZoneView"
                                    Visibility="Collapsed"/>

                <views:MediaWidgetView x:Name="MediaWidgetView"
                                       Visibility="Collapsed"/>

                <views:ClipboardToastView x:Name="ClipboardToastView"
                                          Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border x:Name="ThemeBorder"
                BorderBrush="#FF404040"
                BorderThickness="1"
                CornerRadius="11"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
    </Grid>
</Window>
