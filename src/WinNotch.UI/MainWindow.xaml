<Window x:Class="WinNotch.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinNotch.UI.Views"
        Title="WinNotch"
        Width="100" Height="22"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF0B0B0D"
        AllowsTransparency="False"
        Cursor="Arrow"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Closing="MainWindow_Closing"
        Loaded="MainWindow_Loaded">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseEnter="RootGrid_MouseEnter"
          MouseLeave="RootGrid_MouseLeave"
          AllowDrop="True"
          Drop="RootGrid_Drop"
          DragEnter="RootGrid_DragEnter"
          DragLeave="RootGrid_DragLeave"
          DragOver="RootGrid_DragOver"
          MouseRightButtonUp="RootGrid_MouseRightButtonUp">

        <Border x:Name="NotchBorder"
                Background="#FF0B0B0D"
                CornerRadius="0,0,11,11"
                ClipToBounds="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <StackPanel x:Name="IdleContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="18" Height="3"
                            CornerRadius="1.5"
                            Background="#52FFFFFF"/>
                </StackPanel>

                <StackPanel x:Name="MediaAmbientContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="16" Height="16"
                            CornerRadius="8"
                            Background="#18FFFFFF"
                            Margin="0,0,5,0">
                        <TextBlock Text="▶"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="7"
                                   Foreground="#D8FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="1,0,0,0"/>
                    </Border>
                    <TextBlock x:Name="MediaAmbientTitle"
                               Text="Medya"
                               FontSize="9"
                               Foreground="#C8FFFFFF"
                               MaxWidth="82"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="PinStatusContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="⌖"
                               FontFamily="Segoe UI Symbol"
                               FontSize="11"
                               Foreground="#FF7FB0FF"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="PinStatusText"
                               Text="Pencere sabitlendi"
                               FontSize="9.5"
                               Foreground="#E8FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="120"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <views:DropZoneView x:Name="DropZoneView"
                                    Visibility="Collapsed"/>

                <views:MediaWidgetView x:Name="MediaWidgetView"
                                       Visibility="Collapsed"/>

                <views:ClipboardToastView x:Name="ClipboardToastView"
                                          Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border x:Name="ThemeBorder"
                BorderBrush="#364A4A50"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,11,11"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
    </Grid>
</Window>
