<Window x:Class="WinNotch.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinNotch.UI.Views"
        Title="WinNotch"
        Width="130" Height="28"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF000000"
        AllowsTransparency="False"
        Cursor="Arrow"
        Closing="MainWindow_Closing"
        Loaded="MainWindow_Loaded">

    <!--
        IMPORTANT DESIGN DECISIONS:
        1. AllowsTransparency="False" — We use WS_EX_LAYERED + DWM for native transparency.
           Setting AllowsTransparency="True" would use software blending and waste CPU/GPU.

        2. Background="#FF000000" — 100% opaque black. DWM handles the transparency
           through DwmExtendFrameIntoClientArea + SetWindowRgn for the pill shape.

        3. Topmost="True" — Always on top. Combined with WS_EX_TOOLWINDOW (set in code-behind),
           this creates a persistent widget that doesn't appear in Alt+Tab.

        4. ShowInTaskbar="False" — Hidden from taskbar.

        5. ResizeMode="NoResize" — Fixed size, no user resize.
    -->

    <Grid x:Name="RootGrid" Background="Transparent"
          MouseEnter="RootGrid_MouseEnter"
          MouseLeave="RootGrid_MouseLeave"
          AllowDrop="True"
          Drop="RootGrid_Drop"
          DragEnter="RootGrid_DragEnter"
          DragLeave="RootGrid_DragLeave"
          DragOver="RootGrid_DragOver"
          MouseRightButtonUp="RootGrid_MouseRightButtonUp">

        <!-- Main Notch Container with animation support -->
        <Border x:Name="NotchBorder"
                Background="#FF000000"
                CornerRadius="14"
                ClipToBounds="True"
                Width="130" Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="NotchScale" ScaleX="1" ScaleY="1" CenterX="65" CenterY="14"/>
                    <TranslateTransform x:Name="NotchTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <!-- Default Idle Content -->
                <StackPanel x:Name="IdleContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="1">

                    <!-- Minimal notch indicator icon -->
                    <TextBlock Text="✦"
                               Foreground="#99FFFFFF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <TextBlock Text="WinNotch"
                               Foreground="#CCFFFFFF"
                               FontSize="10"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Drop Zone Content (Module A) -->
                <views:DropZoneView x:Name="DropZoneView"
                                    Visibility="Collapsed"/>

                <!-- Media Widget Content (Module C) -->
                <views:MediaWidgetView x:Name="MediaWidgetView"
                                       Visibility="Collapsed"/>

                <!-- Clipboard Toast Content (Module B/E) -->
                <views:ClipboardToastView x:Name="ClipboardToastView"
                                          Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Theme Border (shown when Windows uses light theme) -->
        <Border x:Name="ThemeBorder"
                BorderBrush="#FF404040"
                BorderThickness="1"
                CornerRadius="14"
                Width="130" Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
    </Grid>
</Window>
